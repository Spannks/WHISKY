# Copy to local.properties (git-ignored) and fill in. Android Studio adds sdk.dir itself.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# The *Web application* OAuth client ID from Google Cloud (not the Android one)
GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
